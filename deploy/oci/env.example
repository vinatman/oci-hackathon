# Required
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example
OCI_AVAILABILITY_DOMAIN=EXAMPLE:US-ASHBURN-AD-1
OCI_IMAGE_NAME=sports-connect
OCI_REGISTRY_NAMESPACE=your-tenancy-namespace
OCI_REGISTRY_REPO=sports-connect
OCI_AUTH_TOKEN=
DATABASE_URL=postgresql://user:password@host:5432/sportsconnect?schema=public

# Optional existing network resources
OCI_SUBNET_OCID=
OCI_VCN_OCID=
OCI_SECURITY_LIST_OCID=

# Optional HTTPS configuration
APP_DOMAIN=
TLS_CERTIFICATE_OCID=

# Optional OCIR login override when your tenancy uses identity domains.
# Example: your-namespace/oracleidentitycloudservice/you@example.com
OCI_USERNAME=
